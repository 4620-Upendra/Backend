       </bean>  -->
       
       
       
       <!-- iii)constructor autowire:Spring looks at the constructor, finds what objects it needs, and supplies them while creating the bean
       ,student class should have single parameter constructor that parameter should be location class object -->
       
        <bean id="std" class="com.coders.SpringCorePart2.First.Student" scope="prototype" autowire="constructor">
       <constructor-arg name="id" value="20"></constructor-arg>
       <constructor-arg name="name" value="construcotr autowire"></constructor-arg>
       <constructor-arg name="age" value="22"></constructor-arg>
       </bean>
       
       <bean class="com.coders.SpringCorePart2.First.Location">
       <constructor-arg name="pin" value="1203"></constructor-arg>
       <constructor-arg name="city" value="vizag"></constructor-arg>
       </bean>
        
</beans>