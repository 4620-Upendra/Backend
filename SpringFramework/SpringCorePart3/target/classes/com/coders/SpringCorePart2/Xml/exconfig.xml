        <!-- creating bean with autowire :there are three ways-->
        <!-- i)byName autowire :  bean id should match with variable name in student class -->
       <!-- <bean id="std" class="com.coders.SpringCorePart2.First.Student" scope="prototype" autowire="byName">
       <constructor-arg name="id" value="20"></constructor-arg>
       <constructor-arg name="name" value="byName autowire"></constructor-arg>
       <constructor-arg name="age" value="22"></constructor-arg>
       </bean>
       
       <bean id="loc" class="com.coders.SpringCorePart2.First.Location">
       <constructor-arg name="pin" value="1203"></constructor-arg>
       <constructor-arg name="city" value="vizag"></constructor-arg>
       </bean>
        -->
        
        
        
        <!-- ii)byType autowire:Spring searches for a single bean of that type and injects it automatically. -->
       <!-- <bean id="std" class="com.coders.SpringCorePart2.First.Student" scope="prototype" autowire="byType">
       <constructor-arg name="id" value="20"></constructor-arg>
       <constructor-arg name="name" value="byType autowire"></constructor-arg>
       <constructor-arg name="age" value="22"></constructor-arg>
       </bean>
       
       <bean class="com.coders.SpringCorePart2.First.Location">
       <constructor-arg name="pin" value="1203"></constructor-arg>
